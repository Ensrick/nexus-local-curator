{
  "manifest_version": 3,
  "name": "Nexus Local Curator",
  "version": "0.13.0",
  "description": "Hide Nexus Mods authors locally and browse an API-powered catalogue containing only unreviewed results.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.nexusmods.com/*",
    "https://api.nexusmods.com/*"
  ],
  "background": {
    "scripts": [
      "src/api-core.js",
      "src/background.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Nexus Local Curator",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nexusmods.com/*"
      ],
      "js": [
        "src/api-core.js",
        "src/shared.js",
        "src/content.js",
        "src/unblock-core.js",
        "src/unblock.js"
      ],
      "css": [
        "src/content.css",
        "src/unblock.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nexus-local-curator@danjo.local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "142.0"
    }
  }
}
